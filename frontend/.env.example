# WebChat Frontend Environment Variables
# Configure your FastAPI backend endpoint for local dev, custom ports, or production deployments.

# Option 1: Full backend URL (default for local development)
VITE_API_BASE_URL=http://localhost:8000/api

# Option 2: Relative path (if serving frontend and backend behind Nginx / Caddy / Cloudflare / Docker proxy)
# VITE_API_BASE_URL=/api

# Option 3: Remote production or custom port
# VITE_API_BASE_URL=https://api.yourdomain.com/api
